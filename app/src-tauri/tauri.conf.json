{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "offsave",
  "version": "0.3.5",
  "identifier": "dev.offsave.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5183",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "offsave",
        "width": 1000,
        "height": 760,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "targets": [
      "deb",
      "appimage",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyQTY4NDc0NDdFOEZFNEMKUldSTS91aEhkSVNtb3YxdHlUU3lYb3NJYjI4RWJVZ1BpbnNsOHBkMjg2Y2tjSG1STzk2RlhFelcK",
      "endpoints": [
        "https://github.com/3pino/offsave/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
